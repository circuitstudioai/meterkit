# =============================================================================
# AI SPEND WALLET - Environment Variables
# =============================================================================
# Copy this file to .env.local for local development
# For production (Vercel), set these in the Vercel dashboard

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Local development: Uses SQLite (leave DATABASE_URL empty)
# Production: Uses Supabase Postgres (set DATABASE_URL)

# Supabase Connection String (Postgres) - Production only
# Format: postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres
# Get from: Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=

# SQLite Path - Local development only (ignored if DATABASE_URL is set)
DATABASE_PATH=./data/wallet.db

# -----------------------------------------------------------------------------
# PAYPAL SANDBOX
# -----------------------------------------------------------------------------
# Get credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# 1. Create or select a sandbox app
# 2. Copy Client ID and Secret from the app details page

# PayPal Sandbox Client ID (required)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# PayPal Sandbox Client Secret (required)
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# PayPal Mode - Always "sandbox" for hackathon (never use "live")
PAYPAL_MODE=sandbox

# PayPal Webhook ID (optional, for webhook signature verification)
# Get from: PayPal Dashboard > Webhooks > Add Webhook
# Webhook URL should be: https://your-domain.vercel.app/api/paypal/webhook
PAYPAL_WEBHOOK_ID=your_webhook_id

# -----------------------------------------------------------------------------
# GOOGLE GEMINI API
# -----------------------------------------------------------------------------
# Get API key from: https://aistudio.google.com/app/apikey
# Used for: AI policy explanation generation (optional, has graceful fallback)
# Default model: gemini-2.5-flash (cheap and fast) via the official @google/genai SDK
# Cost: typically well under $1 for demo usage

GEMINI_API_KEY=your_gemini_api_key

# Optional override. Default is gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# Public URL of your deployed app (used for PayPal redirect URLs)
# Local: http://localhost:43123
# Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:43123

# -----------------------------------------------------------------------------
# SUPABASE (Production only - provided by Supabase agent)
# -----------------------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API

# Supabase Project URL
# Format: https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon/Public Key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (server-side only, keep secret!)
# Only needed if using Row Level Security or admin operations
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# NOTES FOR AI AGENTS
# -----------------------------------------------------------------------------
# 1. DATABASE_URL presence determines local (SQLite) vs production (Postgres)
# 2. All PayPal operations use sandbox mode - never change PAYPAL_MODE to "live"
# 3. GEMINI_API_KEY is optional - app works without it (uses fallback explanations)
# 4. NEXT_PUBLIC_* variables are exposed to the browser (use for non-sensitive data)
# 5. For Vercel deployment: Set all vars in Vercel Dashboard > Project Settings > Environment Variables
# 6. For Supabase setup: Run migrations in supabase/migrations/ after project creation

# -----------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION
# -----------------------------------------------------------------------------
# Minimum required for Vercel + Supabase deployment:
# - DATABASE_URL (from Supabase)
# - PAYPAL_CLIENT_ID (from PayPal sandbox)
# - PAYPAL_CLIENT_SECRET (from PayPal sandbox)
# - NEXT_PUBLIC_APP_URL (your Vercel URL)
#
# Recommended but optional:
# - GEMINI_API_KEY (for AI explanations)
# - PAYPAL_WEBHOOK_ID (for webhook verification)
