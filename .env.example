# =============================================================================
# MeterKit — environment variables
# Copy to .env.local (never commit secrets)
# =============================================================================

# Local SQLite (leave DATABASE_URL empty). Production: Supabase Postgres.
DATABASE_URL=
DATABASE_PATH=./data/wallet.db

# PayPal sandbox — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Gemini (optional; canned/demo replies if missing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:43123
METERKIT_API_URL=http://localhost:43123
NEXT_PUBLIC_METERKIT_API_URL=http://localhost:43123

# Supabase (production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Verified alpha; disabled by default. Server-only except explicitly VITE_* values in target app.
METERKIT_ALPHA_ENABLED=false
METERKIT_ALPHA_ORIGIN=
METERKIT_ALPHA_POLICY=
METERKIT_ALPHA_DATA_APPROVED=false
SIGNAL_SUPABASE_URL=
SIGNAL_SUPABASE_ANON_KEY=
PAYPAL_MERCHANT_ID=

# Public sandbox chatbot example — all switches default off. NOT activation instructions.
# Existing hosted Auth/payment/data approvals must pass before setting these to true.
METERKIT_CHAT_ENABLED=false
METERKIT_CHAT_UI_ENABLED=false
METERKIT_CHAT_SANDBOX_POLICY_APPROVED=false
METERKIT_CHAT_DATA_APPROVED=false
METERKIT_CHAT_APP_ID=
METERKIT_CHAT_ORIGIN=
METERKIT_CHAT_SUPABASE_URL=
# Public anon key ONLY; never a service-role key. This value reaches the opted-in browser UI.
METERKIT_CHAT_SUPABASE_ANON_KEY=
